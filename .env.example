# Copy to .env (never commit it). Generate secrets with: npm run keys
NODE_ENV=production
PORT=3000
# Number of reverse proxies in front of the app (1 behind most hosts / load balancers)
TRUST_PROXY=1
ALLOWED_ORIGINS=https://tidytail.example
DATA_DIR=./data
LEAD_RETENTION_DAYS=365
FORM_RATE_LIMIT=8
MIN_FILL_MS=3000

CSRF_SECRET=
LEAD_ENCRYPTION_KEY=
HASH_PEPPER=
ADMIN_TOKEN_SHA256=
